<%
  label ||= nil
  hint ||= nil
  error ||= nil
  required ||= false
  html_options ||= {}
  content ||= nil

  classes = ["mb-5", html_options.delete(:class)].compact_blank.join(" ")
%>

<div class="<%= classes %>" <%= tag.attributes(html_options) %>>
  <% if label %>
    <label class="block mb-2 text-sm font-medium text-zinc-900 dark:text-white">
      <%= label %>
      <% if required %><span class="text-red-500 ms-1">*</span><% end %>
    </label>
  <% end %>
  <%= content %>
  <% if hint %>
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400"><%= hint %></p>
  <% end %>
  <% if error %>
    <p class="mt-1 text-xs text-red-600 dark:text-red-500"><%= error %></p>
  <% end %>
</div>
